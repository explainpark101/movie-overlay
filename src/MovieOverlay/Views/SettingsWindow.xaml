<Window x:Class="MovieOverlay.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MovieOverlay.Controls"
        Title="Movie Overlay"
        Width="560"
        Height="560"
        MinWidth="480"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F0F"
        Foreground="#F5F5F5"
        ResizeMode="CanResizeWithGrip">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <TextBlock x:Name="StatusText"
                 Margin="0,0,0,12"
                 FontSize="16"
                 FontWeight="SemiBold"
                 Foreground="#2DD4BF"
                 Text="Stopped" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center"
                   Foreground="#A3A3A3"
                   Text="Dark = blackout on idle. Teal = keep visible. Move mouse to restore."
                   TextWrapping="Wrap" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="StartStopButton"
                  Content="Start"
                  Padding="20,8"
                  Margin="0,0,8,0"
                  FontWeight="SemiBold"
                  Click="StartStopButton_OnClick" />
          <Button x:Name="ApplyButton"
                  Content="Save"
                  Padding="16,8"
                  Margin="0,0,8,0"
                  Click="ApplyButton_OnClick" />
          <Button Content="Close"
                  Padding="16,8"
                  Click="CloseButton_OnClick" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4"
                   Text="Movie Overlay" />
        <TextBlock Foreground="#A3A3A3"
                   Margin="0,0,0,16"
                   TextWrapping="Wrap"
                   Text="Click a display to toggle blackout. Layout matches your Windows arrangement." />

        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="Displays" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="14" Height="14" Background="#111111" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="2" />
            <TextBlock Margin="6,0,14,0" Foreground="#A3A3A3" VerticalAlignment="Center" Text="Blackout" />
            <Border Width="14" Height="14" Background="#0D9488" BorderBrush="#2DD4BF" BorderThickness="1" CornerRadius="2" />
            <TextBlock Margin="6,0,0,0" Foreground="#A3A3A3" VerticalAlignment="Center" Text="Keep" />
          </StackPanel>
        </Grid>
        <controls:MonitorMapControl x:Name="MonitorMap" Height="220" />

        <Grid Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="120" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Mouse idle (seconds)" />
            <TextBlock Foreground="#A3A3A3"
                       FontSize="12"
                       Text="After Start, overlay appears when the cursor stays still this long." />
          </StackPanel>
          <TextBox x:Name="IdleSecondsBox"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   Padding="8,6"
                   TextAlignment="Right" />
        </Grid>

        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="120" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="Movement threshold (px)" />
            <TextBlock Foreground="#A3A3A3"
                       FontSize="12"
                       Text="Ignore cursor jitter smaller than this distance." />
          </StackPanel>
          <TextBox x:Name="MovementThresholdBox"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   Padding="8,6"
                   TextAlignment="Right" />
        </Grid>

        <CheckBox x:Name="PreferHardwareBrightnessBox"
                  Margin="0,16,0,0"
                  Content="Prefer hardware brightness 0 (DDC/CI); overlay fallback if unsupported" />

        <CheckBox x:Name="ClickThroughBox"
                  Margin="0,10,0,0"
                  Content="Click-through overlay (mouse passes through black screens)" />

        <CheckBox x:Name="StartWithWindowsBox"
                  Margin="0,10,0,0"
                  Content="Start with Windows" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
