<UserControl x:Class="MovieOverlay.Controls.MonitorMapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="180">
  <Grid>
    <Border Background="#141414"
            BorderBrush="#2A2A2A"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
      <Canvas x:Name="MapCanvas"
              ClipToBounds="True"
              SizeChanged="MapCanvas_OnSizeChanged" />
    </Border>
  </Grid>
</UserControl>
